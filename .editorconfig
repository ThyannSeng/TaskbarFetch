root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf

[*.{cmd,ps1}]
end_of_line = crlf

[*.{cs,csproj,props}]
indent_style = space
indent_size = 4

[*.{csproj,props}]
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.sln]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

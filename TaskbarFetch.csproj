<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TaskbarFetch</RootNamespace>
    <AssemblyName>$(TaskbarFetchPortableFilePrefix)$(TaskbarFetchVersion)</AssemblyName>
    <AssemblyTitle>TaskbarFetch</AssemblyTitle>
    <Product>TaskbarFetch</Product>
    <Company>Thyann Seng</Company>
    <Copyright>Copyright (c) 2026 Thyann Seng</Copyright>
    <Description>Move an existing app window to the monitor whose taskbar button was clicked.</Description>
    <Version>$(TaskbarFetchVersion)</Version>
    <InformationalVersion>$(TaskbarFetchVersion)</InformationalVersion>
    <AssemblyVersion>$(TaskbarFetchAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(TaskbarFetchFileVersion)</FileVersion>
    <ApplicationIcon>assets\TaskbarFetch.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Accessibility" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
